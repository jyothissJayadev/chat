# Single DeepInfra account key — it authenticates every model role below
# (classify/extract/question/answer/vision/embed all share one AsyncOpenAI
# client in app/deepinfra.py). You only need to fill in this one key.
DEEP_INFRA_API=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai

MONGO_URI=mongodb+srv://...
MONGO_DB_NAME=interior_design_chat

# Model IDs are just routing config, not separate credentials — all calls
# still authenticate with the one DEEP_INFRA_API key above.
MODEL_INTENT_CLASSIFIER=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
MODEL_EXTRACTION=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
MODEL_QUESTION_GEN=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
MODEL_ANSWER=deepseek-ai/DeepSeek-V4-Pro
MODEL_VISION=Qwen/Qwen3-VL-30B-A3B-Instruct
MODEL_EMBEDDING=Qwen/Qwen3-Embedding-8B

SESSION_TTL_DAYS=30

# Optional — LLM observability/tracing. Leave blank to disable; nothing breaks.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
