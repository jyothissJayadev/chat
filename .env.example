# Single LLM provider account key — it authenticates every model role below
# (classify/extract/question/answer/vision/embed all share one AsyncOpenAI
# client in app/llm.py). You only need to fill in this one key. Currently
# Fireworks AI; the field/env-var names are deliberately provider-generic —
# switching providers again later is just this value + LLM_BASE_URL + the
# MODEL_* slugs below, not a code change.
LLM_API_KEY=
LLM_BASE_URL=https://api.fireworks.ai/inference/v1

MONGO_URI=mongodb+srv://...
MONGO_DB_NAME=interior_design_chat

# Model IDs are just routing config, not separate credentials — all calls
# still authenticate with the one LLM_API_KEY above. model_vision/
# model_embedding aren't confirmed live on Fireworks yet — see app/config.py.
MODEL_INTENT_CLASSIFIER=accounts/fireworks/models/gpt-oss-120b
MODEL_EXTRACTION=accounts/fireworks/models/gpt-oss-120b
MODEL_QUESTION_GEN=accounts/fireworks/models/gpt-oss-120b
MODEL_ANSWER=accounts/fireworks/models/gpt-oss-120b
MODEL_VISION=accounts/fireworks/models/qwen3p7-plus
MODEL_EMBEDDING=accounts/fireworks/models/qwen3-embedding-8b

SESSION_TTL_DAYS=30

# Optional — LLM observability/tracing. Leave blank to disable; nothing breaks.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
